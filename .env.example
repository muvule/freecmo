# FreeCMO Progressive BYOK Configuration (Copy to .env; never commit .env)

# Primary LLM Provider (choose one or configure multiple for multi-model GEO benchmark)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# Local OpenAI-compatible / Ollama endpoint (optional; zero external API cost)
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=llama3.1:8b

# Model tier overrides (fast_decider | balanced_worker | deep_orchestrator | multimodal_creative)
CMO_FAST_MODEL=
CMO_WORKER_MODEL=
CMO_ORCHESTRATOR_MODEL=
CMO_MULTIMODAL_MODEL=

# Optional Tier 1 Read-Only Platform Credentials (leave blank for Tier 0 CSV dropzone mode)
GA4_PROPERTY_ID=
GSC_SITE_URL=
GOOGLE_ADS_CUSTOMER_ID=
META_AD_ACCOUNT_ID=
POSTHOG_PROJECT_ID=
KLAVIYO_API_KEY=
