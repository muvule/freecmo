# FreeCMO Progressive BYOK Configuration (Copy to .env; never commit .env)
# Zero keys required for deterministic calculators, local MCP tools, or Tier 0 CSV mode.

# ============================================================================
# 1. LLM Providers — Frontier, OpenRouter / Cheaper AI APIs, or Local Machine
# ============================================================================
# Explicit provider selector (auto | openai | anthropic | gemini | gemini-hydrogen | openrouter | deepseek | groq | together | ollama | lmstudio)
CMO_LLM_PROVIDER=auto

# Frontier & $0 AI Studio Free Tier Cloud APIs
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

GEMINI_API_KEY=
GEMINI_MODEL=gemini-4-hydrogen
# Supported on gemini-4-hydrogen: LOW | MEDIUM | HIGH | XHIGH
GEMINI_THINKING_LEVEL=HIGH

# Cheaper / Multi-Model Aggregators (OpenAI-compatible)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=deepseek/deepseek-chat

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

TOGETHER_API_KEY=
TOGETHER_BASE_URL=https://api.together.xyz/v1
TOGETHER_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo

# Local BYO-Machine LLMs (100% private, $0 API cost — Ollama, LM Studio, vLLM, llama.cpp)
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=qwen2.5:14b

LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
LMSTUDIO_MODEL=local-model

# Optional per-tier overrides (fast_decider | balanced_worker | deep_orchestrator | multimodal_creative)
CMO_FAST_MODEL=
CMO_WORKER_MODEL=
CMO_ORCHESTRATOR_MODEL=
CMO_MULTIMODAL_MODEL=

# ============================================================================
# 2. Automated Read-Only Ad, Social (IG/FB), Analytics & Revenue Sync
#    Run: python3 scripts/sync_platforms.py --emit-brief
# ============================================================================

# Shared Google OAuth2 Read-Only Credentials (used by Google Ads, GA4, and Search Console)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_OAUTH_ACCESS_TOKEN=

# Google Ads (API v26; developer-token sunset Sept 2026 and optional)
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_DEVELOPER_TOKEN=

# Meta Ads + Instagram Business + Facebook Page Insights (Graph API v27.0)
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
IG_BUSINESS_ACCOUNT_ID=
FB_PAGE_ID=

# LinkedIn Campaign Manager (LinkedIn-Version 202610) & TikTok Ads (v1.3)
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AD_ACCOUNT_ID=
TIKTOK_ACCESS_TOKEN=
TIKTOK_ADVERTISER_ID=

# Analytics & Search Console (GA4 Data API v1beta keyEvents + GSC v3)
GA4_PROPERTY_ID=
GSC_SITE_URL=
POSTHOG_PROJECT_ID=

# Revenue & Lifecycle Attribution (PII is SHA-256 hashed locally before storage)
# Stripe restricted key needs read on PaymentIntents + Charges; Shopify uses Admin GraphQL 2026-10
STRIPE_RESTRICTED_KEY=
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ADMIN_TOKEN=
KLAVIYO_API_KEY=
