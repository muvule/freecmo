{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://freecmo.org/schemas/experiment.schema.json",
  "title": "ExperimentContract",
  "type": "object",
  "required": [
    "experiment_id",
    "channel",
    "hypothesis",
    "primary_metric",
    "min_runtime_days",
    "target_sample_size",
    "disproof_condition",
    "status",
    "platform_execution_mode"
  ],
  "additionalProperties": false,
  "properties": {
    "experiment_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "channel": {
      "type": "string",
      "enum": ["paid_search", "paid_social", "seo_geo", "cro", "email", "social_organic", "lifecycle"]
    },
    "hypothesis": {
      "type": "string",
      "minLength": 10
    },
    "primary_metric": {
      "type": "string",
      "minLength": 2
    },
    "min_runtime_days": {
      "type": "integer",
      "minimum": 1,
      "maximum": 90
    },
    "target_sample_size": {
      "type": "integer",
      "minimum": 10
    },
    "disproof_condition": {
      "type": "string",
      "minLength": 8
    },
    "max_spend_usd": {
      "type": "number",
      "minimum": 0
    },
    "status": {
      "type": "string",
      "enum": ["proposed", "staged_paused", "running", "won", "killed", "inconclusive"]
    },
    "platform_execution_mode": {
      "type": "string",
      "enum": ["google_ads_validate_only", "meta_paused_study", "posthog_flag", "code_pr_branch", "tier0_csv_manual"]
    },
    "observed_metrics": {
      "type": "object",
      "additionalProperties": {
        "type": ["number", "string"]
      }
    },
    "created_at": { "type": "string" },
    "concluded_at": { "type": "string" }
  }
}
