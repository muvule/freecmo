{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://freecmo.org/schemas/composers_brief.schema.json",
  "title": "ComposersBriefDualReadout",
  "type": "object",
  "required": [
    "brief_id",
    "generated_at",
    "strategy_lock_status",
    "human_readout",
    "agent_brief"
  ],
  "additionalProperties": false,
  "properties": {
    "brief_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "generated_at": { "type": "string" },
    "strategy_lock_status": {
      "type": "string",
      "enum": ["draft_pending_review", "locked"]
    },
    "circuit_breakers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["alert_id", "severity", "message", "recommended_pause"],
        "additionalProperties": false,
        "properties": {
          "alert_id": { "type": "string" },
          "severity": { "type": "string", "enum": ["critical", "warning"] },
          "message": { "type": "string" },
          "recommended_pause": { "type": "boolean" }
        }
      }
    },
    "human_readout": {
      "type": "object",
      "required": ["executive_summary", "ranked_decisions", "segment_budget_shifts"],
      "additionalProperties": false,
      "properties": {
        "executive_summary": { "type": "string", "minLength": 10 },
        "ranked_decisions": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "object",
            "required": [
              "rank",
              "priority",
              "decision_title",
              "rationale",
              "dollar_impact_usd",
              "disproof_condition",
              "source_receipts"
            ],
            "additionalProperties": false,
            "properties": {
              "rank": { "type": "integer", "minimum": 1, "maximum": 5 },
              "priority": { "type": "string", "enum": ["P0", "P1", "P2"] },
              "decision_title": { "type": "string", "minLength": 5 },
              "rationale": { "type": "string", "minLength": 10 },
              "dollar_impact_usd": { "type": "number" },
              "disproof_condition": { "type": "string", "minLength": 5 },
              "source_receipts": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string" }
              }
            }
          }
        },
        "segment_budget_shifts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["from_segment", "to_segment", "amount_usd", "marginal_roi_delta_pct"],
            "additionalProperties": false,
            "properties": {
              "from_segment": { "type": "string" },
              "to_segment": { "type": "string" },
              "amount_usd": { "type": "number", "minimum": 0 },
              "marginal_roi_delta_pct": { "type": "number" }
            }
          }
        }
      }
    },
    "agent_brief": {
      "type": "object",
      "required": ["subtasks"],
      "additionalProperties": false,
      "properties": {
        "subtasks": {
          "type": "array",
          "items": {
            "$ref": "subtask_spec.schema.json"
          }
        }
      }
    }
  }
}
