{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://freecmo.org/schemas/worker_output.schema.json",
  "title": "WorkerOutputBundle",
  "type": "object",
  "required": [
    "subtask_id",
    "skill_name",
    "status",
    "claims",
    "metrics",
    "source_receipts",
    "proposed_bets",
    "flash_points_flagged",
    "markdown_summary"
  ],
  "additionalProperties": false,
  "properties": {
    "subtask_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "skill_name": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "status": {
      "type": "string",
      "enum": ["pass", "fail", "unknown", "partial"]
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["epistemic_tag", "statement", "source_receipt_id"],
        "additionalProperties": false,
        "properties": {
          "epistemic_tag": {
            "type": "string",
            "enum": ["STONE", "OPINION"]
          },
          "statement": { "type": "string", "minLength": 3 },
          "source_receipt_id": { "type": "string", "minLength": 1 }
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": {
        "type": ["number", "string", "null"]
      }
    },
    "source_receipts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["receipt_id", "source_type", "location", "excerpt"],
        "additionalProperties": false,
        "properties": {
          "receipt_id": { "type": "string", "minLength": 1 },
          "source_type": {
            "type": "string",
            "enum": ["csv", "url", "repo_file", "calculator", "mcp", "radar_db", "user_note"]
          },
          "location": { "type": "string", "minLength": 1 },
          "row_range": { "type": "string" },
          "excerpt": { "type": "string", "minLength": 1 }
        }
      }
    },
    "proposed_bets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["bet_id", "hypothesis", "primary_metric", "disproof_condition"],
        "additionalProperties": false,
        "properties": {
          "bet_id": { "type": "string", "minLength": 1 },
          "hypothesis": { "type": "string", "minLength": 5 },
          "primary_metric": { "type": "string", "minLength": 1 },
          "disproof_condition": { "type": "string", "minLength": 5 },
          "estimated_spend_usd": { "type": "number", "minimum": 0 },
          "target_entities": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "flash_points_flagged": {
      "type": "array",
      "items": { "type": "string" }
    },
    "tool_calls_used": {
      "type": "integer",
      "minimum": 0
    },
    "tokens_used": {
      "type": "integer",
      "minimum": 0
    },
    "markdown_summary": {
      "type": "string",
      "minLength": 1
    }
  }
}
